# Copie este arquivo para ".env" (que NÃO vai para o git) e preencha os valores.
# Em produção, cadastre as mesmas variáveis no painel da hospedagem
# (Vercel: Project → Settings → Environment Variables).
#
# Atenção: tudo que começa com VITE_ é embutido no JavaScript público do site.
# Nunca coloque aqui senhas, tokens de API privados ou chaves secretas.

# Endereço público do site, sem barra no final. Usado no canonical, og:url, sitemap.xml e robots.txt.
# Na Vercel pode ficar vazio: o build usa automaticamente o domínio de produção do projeto.
VITE_SITE_URL=https://www.seudominio.com.br

# ID de métricas do Google Analytics 4 (Admin → Fluxos de dados → Web). Só carrega após o visitante aceitar os cookies.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# DSN do projeto no Sentry (Settings → Client Keys). Monitoramento de erros; só ativa na build de produção.
VITE_SENTRY_DSN=

# Código de verificação do Google Search Console (método "Tag HTML"; só o valor do content).
VITE_GOOGLE_SITE_VERIFICATION=
